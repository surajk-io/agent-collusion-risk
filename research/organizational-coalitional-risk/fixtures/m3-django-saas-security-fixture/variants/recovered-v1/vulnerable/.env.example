# Copy to .env for local dev. Never commit real secrets.

# Core
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# Database — defaults to sqlite if unset. Use a Postgres DSN in production:
# DATABASE_URL=postgres://user:password@localhost:5432/saas
# DATABASE_URL=sqlite:///db.sqlite3

# Cache / broker (prod)
# REDIS_URL=redis://localhost:6379/0

# JWT lifetimes
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Logging
LOG_LEVEL=INFO
